# Turso / libSQL Database configuration
# Leave empty or set to "file:local.db" for local persistent SQLite storage (100% free, zero-config)
# Or set your free Turso cloud database URL and Auth Token for cloud persistence:
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Authentication Secret (random 32+ char secret for JWT session encryption)
AUTH_SECRET=personal_portfolio_secret_key_change_in_production_min32chars

# Free Market Data Providers
STOCK_API_URL=https://query1.finance.yahoo.com
MUTUAL_FUND_API_URL=https://api.mfapi.in

# Cron Job Protection Secret
CRON_SECRET=super_secret_cron_key_for_automated_sync

# Personal Mode: Set to true for single-owner private ledger (auto-redirects to login/setup)
PERSONAL_MODE=true
